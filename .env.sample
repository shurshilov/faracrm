# =============================================================================
# FARA CRM — пример конфигурации (.env.sample)

dotorm_databases_postgres__fara__host="127.0.0.1"
dotorm_databases_postgres__fara__port=5432
dotorm_databases_postgres__fara__user="openpg"
dotorm_databases_postgres__fara__password="openpgpwd"
dotorm_databases_postgres__fara__driver="asyncpg"
dotorm_databases_postgres__fara__database="fara"
dotorm_databases_postgres__fara__sync_db=true
#dotorm_databases_postgres__fara__reconnect_timeout=10
#dotorm_databases_postgres__fara__ssl=""


# ───────────────────────────── Logger ─────────────────────────────
# Уровень логирования всего приложения.
logger__log_level="INFO"

# Типичные сетапы:
#
# 1) Локальная разработка (vite dev на :5173, uvicorn напрямую на :8090):
#      site_url="http://127.0.0.1:5173"
#      api_url="http://127.0.0.1:8090"
#
# 2) Prod через nginx (один домен):
#      site_url="https://mydomain.com"
#      api_url="https://mydomain.com/api"
#
# 3) Docker compose (всё локально, фронт на :7777, бэк через nginx):
#      site_url="http://127.0.0.1:7777"
#      api_url="http://127.0.0.1:7777/api"

# site_url="http://127.0.0.1:5173"
# api_url="http://127.0.0.1:8090"


# ─────────────────────────────── Cron ─────────────────────────────
# Фоновые задачи (cron worker).
#cron__enabled=true
#cron__check_interval=60
#cron__max_threads=2


# ─────────────────────────── Chat module ──────────────────────────
# Настройки чат-модуля. Для pub/sub смотри секцию PubSub ниже —
# это отдельные, независимые настройки (разные места использования).
#chat__pubsub_backend=pg
#chat__redis_url="redis://localhost:6379/0"
#chat__redis_channel=ws_events
#chat__pg_channel=ws_events
#chat__pg_max_payload=7900


# ─────────────────────────── TURN / STUN ─────────────────────────
# Релей для звонков — общий и для внутренних WebRTC между сотрудниками, и
# для звонилки в браузере к АТС. Нужен там, где прямое соединение не
# собирается: симметричный NAT (мобильные операторы), закрытый наружу UDP.
#
# ВСЁ РАБОТАЕТ ИЗ КОРОБКИ: coturn поднимается вместе с остальными сервисами
# (docker compose up -d), секрет генерируется сам, адрес релея берётся из
# site_url. Единственное, что нужно сделать руками, — открыть порты на хосте:
#     sudo ufw allow 3478/udp && sudo ufw allow 3478/tcp
#     sudo ufw allow 49160:49660/udp
# (host-сеть, в отличие от опубликованных портов, правила ufw не обходит).
#
# ВАЖНО ПРО РЕГИСТР: строки ниже читает и бэкенд, и docker compose. Бэкенду
# регистр безразличен, а compose ищет ТОЧНОЕ совпадение имени — поэтому
# заглавными. Строчный turn__realm compose просто не увидит, и релей
# поднимется с чужим realm.
#
# Выключить релей (звонки пойдут только напрямую, по STUN):
#TURN__ENABLED=false
#
# Адрес релея, если он НЕ совпадает с доменом CRM (отдельная машина). Пусто —
# берём хост из site_url. Адрес обязан быть ПУБЛИЧНЫМ: он уезжает в браузер
# клиента, имя докер-сервиса тут не сработает.
#TURN__HOST="turn.example.com"
#
# Всё, что ниже — ДЕФОЛТЫ. Их же можно менять в интерфейсе: «Системные
# настройки», ключи turn.* — это применяется со следующего звонка, без
# перезапуска. Пустое значение в интерфейсе означает «взять отсюда».
#TURN__PORT=3478
# turns: (TLS) анонсируем только когда у релея есть сертификат —
# см. docker/turnserver.conf, раздел TLS.
#TURN__TLS_PORT=0
# Сколько живут выданные браузеру креды, секунд.
#TURN__TTL=3600
# Гнать ВЕСЬ трафик через релей (скрывает IP собеседников друг от друга,
# но вся нагрузка ложится на сервер). На звонки к АТС не влияет.
#TURN__FORCE_RELAY=false
# Запасные STUN: и пока своего релея нет, и как страховка, если он упал.
# Пустой список — никаких внешних зависимостей (закрытый контур).
#TURN__FALLBACK_STUN='["stun:stun.l.google.com:19302"]'
#
# Секрет обычно НЕ задают: он генерируется сам. Задать здесь имеет смысл
# только если секреты приносит внешний менеджер — тогда его придётся руками
# положить и релею (--static-auth-secret в TURN_EXTRA_ARGS).
#TURN__SECRET=""
# Где лежит сгенерированный секрет ВНУТРИ контейнера бэкенда. В докере это
# задано в docker-compose.yml; здесь — только для запуска без докера.
#TURN__SECRET_FILE="/run/turn/secret"
# realm релея (в креды не входит, влияет только на диалог авторизации).
#TURN__REALM="fara"
#
# Параметры площадки для самого coturn (в контейнер, не в бэкенд):
#   --external-ip=<белый IP>  — облако с 1:1 NAT (AWS/Yandex Cloud)
#   --allowed-peer-ip=<АТС>   — если АТС в приватной сети
#TURN_EXTRA_ARGS=


# ──────────────────────── Auth / Session cookie ───────────────────
# Настройки куки авторизации.
# На продакшене включи cookie_secure=true (куки только по HTTPS).
# cookie_samesite=none требует cookie_secure=true (стандарт браузеров).
#auth__cookie_secure=false
#auth__cookie_name=session_cookie
#auth__cookie_samesite=lax
